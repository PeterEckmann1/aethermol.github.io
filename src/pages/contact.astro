---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import ContactUs from '~/components/widgets/Contact.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact',
};
---

<Layout metadata={metadata}>
  <!-- HeroText Widget ******************* -->

  <HeroText tagline="Contact" title="Let's Connect!" />

 

  <!-- Features2 Widget ************** -->

  <Features2
    items={[
      {
        title: 'Contact Support',
        description:
          'Chat with us for questions about partnership, customization options, licensing for commercial use, etc.',
      },

      {
        title: 'Email',
        description: 'contact@aethermol.ai',
        icon: 'tabler:mail',
      },
      {
        title: 'Location',
        description: '9500 Gilman Drive, Mail Code 0404, La Jolla, CA 92093',
        icon: 'tabler:map-pin',
      },
    ]}
  />
</Layout>
