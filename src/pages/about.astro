---
import Features2 from '~/components/widgets/Features2.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Hero from '~/components/widgets/Hero.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About Aethermol',
};

// Co-founder images and profiles
const coFounders = [
  {
    name: 'Peter Eckmann',
    role: 'Co-founder',
    description: "Expert in AI and drug discovery. Leading the technical development of Aethermol's AI platform.",
    image: 'https://github.com/PeterEckmann1.png',
    links: [
      { url: 'https://petereckmann1.github.io/', label: 'Website' },
      { url: 'https://github.com/PeterEckmann1', label: 'GitHub' },
    ],
  },
  {
    name: 'Rose Yu',
    role: 'Co-founder',
    description:
      'Pioneer in scientific machine learning. Bringing expertise in physics-guided deep learning to Aethermol.',
    image: 'https://roseyu.com/images/profile.jpg',
    links: [{ url: 'https://roseyu.com/', label: 'Website' }],
  },
];
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    tagline="About Aethermol"
    image={{
      src: '~/assets/images/splashimage.jpg',
      alt: 'Aethermol Drug Discovery',
    }}
  >
    <Fragment slot="title">
      Revolutionizing Drug Discovery with <br />
      <span class="text-accent dark:text-white">Generative AI Innovation</span>
    </Fragment>

    <Fragment slot="subtitle">
      Founded by experts in machine learning and chemical science, Aethermol is dedicated to accelerating drug discovery
      through innovative AI solutions. Our platform combines cutting-edge generative AI techniques with deep
      understanding of molecular dynamics to create more effective, safer therapeutics.
    </Fragment>
  </Hero>

  <!-- Features2 Widget ************** -->

  <Features2
    title="Our Founders"
    subtitle="Meet the team behind Aethermol"
    columns={2}
    items={[
      {
        title: 'Peter Eckmann',
        description: coFounders[0].description,
        icon: 'tabler:code',
        callToAction: {
          target: '_blank',
          text: 'Learn More',
          href: 'https://petereckmann1.github.io/',
        },
      },
      {
        title: 'Rose Yu',
        description: coFounders[1].description,
        icon: 'tabler:brain',
        callToAction: {
          target: '_blank',
          text: 'Learn More',
          href: 'https://roseyu.com/',
        },
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Scientific Advisory Board"
    subtitle="Expert guidance shaping our scientific direction"
    columns={1}
    items={[
      {
        title: 'Michael K. Gilson, Ph.D.',
        description:
          "Professor of Pharmaceutical Sciences at UC San Diego and expert in computational chemistry and drug discovery. Dr. Gilson brings decades of experience in molecular modeling, binding thermodynamics, and computer-aided drug design to guide Aethermol's scientific strategy.",
        icon: 'tabler:flask',
        callToAction: {
          target: '_blank',
          text: 'Learn More',
          href: 'https://gilson.cloud.ucsd.edu/',
        },
      },
    ]}
  />

  <!-- Stats Widget ****************** -->

  <!-- <Stats
    title="Our Impact"
    stats={[
      { title: 'Compounds Generated', amount: '1M+' },
      { title: 'Drug Targets', amount: '100+' },
      { title: 'Success Rate', amount: '85%' },
      { title: 'Research Papers', amount: '25+' },
    ]}
  /> -->

  <!-- Features3 Widget ************** -->

  <Features3
    title="Our Technology"
    subtitle="Discover how Aethermol is transforming drug discovery through innovative AI solutions"
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'Advanced AI Models',
        description:
          'Our proprietary AI models combine deep learning with molecular dynamics to predict drug-target interactions with unprecedented accuracy.',
        icon: 'tabler:brain',
      },
      {
        title: 'Molecular Design',
        description:
          'Generate novel drug candidates optimized for efficacy, safety, and synthesizability using our advanced molecular design algorithms.',
        icon: 'tabler:atom',
      },
      {
        title: 'Rapid Iteration',
        description:
          'Accelerate the drug discovery process through rapid iteration and optimization of promising compounds.',
        icon: 'tabler:refresh',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Our Values"
    subtitle="At Aethermol, our work is guided by these core principles"
    items={[
      {
        title: 'Scientific Excellence',
        description:
          'We maintain the highest standards of scientific rigor in our research and development, ensuring reliable and reproducible results.',
        icon: 'tabler:chart-dots',
      },
      {
        title: 'Innovation',
        description:
          'We continuously push the boundaries of AI and computational chemistry to develop novel solutions for drug discovery.',
        icon: 'tabler:bulb',
      },
      {
        title: 'Impact',
        description:
          'Our ultimate goal is to make a meaningful impact on human health by accelerating the development of effective therapeutics.',
        icon: 'tabler:heart',
      },
    ]}
  />

  <!-- Steps2 Widget ****************** -->

  <Steps2
    title="Research Impact"
    subtitle="Our contributions to the field of AI-powered drug discovery"
    isReversed={true}
    items={[
      {
        title: 'Publications',
        description:
          'Our team regularly publishes research findings in top-tier conferences and journals, advancing the field of AI in drug discovery.',
        icon: 'tabler:book',
      },
      {
        title: 'Collaborations',
        description:
          'Partnering with leading research institutions and pharmaceutical companies to validate and implement our technology.',
        icon: 'tabler:users',
      },
      {
        title: 'Open Science',
        description:
          'Contributing to the scientific community through open-source tools and datasets, all available on our GitHub.',
        icon: 'tabler:share',
      },
    ]}
  />

  <!-- Features3 Widget ************** -->

  <Features3
    title="Key Publications"
    subtitle="Selected research papers from our team"
    columns={1}
    items={[
      {
        title: 'MF-LAL: Drug Compound Generation Using Multi-Fidelity Latent Space Active Learning',
        description:
          'Eckmann P, Wu D, Heinzelmann G, Gilson MK, Yu R (2025). International Conference on Machine Learning (ICML)',
        icon: 'tabler:file-text',
        callToAction: {
          text: 'Read Paper',
          href: 'https://arxiv.org/pdf/2410.11226',
          target: '_blank',
        },
      },
      {
        title: 'MFBind: a Multi-Fidelity Approach for Evaluating Drug Compounds in Practical Generative Modeling',
        description: 'Eckmann P, Wu D, Heinzelmann G, Gilson MK, Yu R (2024). arXiv:2402.10387',
        icon: 'tabler:file-text',
        callToAction: {
          text: 'Read Paper',
          href: 'https://petereckmann1.github.io/files/mfbind.pdf',
          target: '_blank',
        },
      },
      {
        title: 'LIMO: Latent Inceptionism for Targeted Molecule Generation',
        description:
          'Eckmann P, Sun K, Zhao B, Feng M, Gilson MK, Yu R (2022). International Conference on Machine Learning (ICML)',
        icon: 'tabler:file-text',
        callToAction: {
          text: 'Read Paper',
          href: 'https://petereckmann1.github.io/files/limo.pdf',
          target: '_blank',
        },
      },
    ]}
  />

  <Features3
    subtitle="Patents and Technical Reports"
    columns={1}
    items={[
      {
        title: 'Computational architecture to generate representations of molecules having targeted properties',
        description:
          'Yu R, Eckmann P, Sun K, Zhao B, Feng M, Gilson MK (2023). United States patent pending US20240005179A1',
        icon: 'tabler:certificate',
        callToAction: {
          text: 'View Patent',
          href: 'https://patents.google.com/patent/US20240005179A1/en',
          target: '_blank',
        },
      },
      {
        title: 'Improving the properties of molecules generated by LIMO',
        description: 'Thumuluri V, Eckmann P, Gilson MK, Yu R (2024). Technical Report. arXiv:2407.14968',
        icon: 'tabler:file-text',
        callToAction: {
          text: 'Read Report',
          href: 'https://petereckmann1.github.io/files/2407.14968v1.pdf',
          target: '_blank',
        },
      },
    ]}
  />

  <!-- Features2 Widget ************** -->

  <Features2
    title="Get in Touch"
    subtitle="Interested in learning more about our technology or discussing collaboration opportunities?"
    columns={2}
    items={[
      {
        title: 'Contact Us',
        description: 'Reach out to discuss how Aethermol can accelerate your drug discovery projects.',
        icon: 'tabler:messages',
        callToAction: {
          text: 'Get in Touch',
          href: '/contact',
        },
      },
      {
        title: 'Research',
        description: 'Learn more about our technology and research through our published work.',
        icon: 'tabler:notebook',
        callToAction: {
          text: 'View Publications',
          href: '#',
        },
      },
    ]}
  />
</Layout>
