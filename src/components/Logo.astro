---
import { SITE } from 'astrowind:config';
import GeminiLogo from '~/assets/images/Gemini_logo_transparent.png';
---

<div class="flex items-center">
  <img src={GeminiLogo.src} alt={`${SITE?.name} logo`} class="h-8 w-auto mr-2 dark:invert" />
  <span class="self-center text-2xl md:text-xl font-bold text-gray-900 whitespace-nowrap dark:text-white">
    {SITE?.name}
  </span>
</div>
