---
import { SITE } from 'astrowind:config';
import LogoLight from '~/assets/images/aethermol-lockup-light.svg';
import LogoDark from '~/assets/images/aethermol-lockup-dark.svg';
---

<div class="flex items-center">
  <img src={LogoLight.src} alt={`${SITE?.name} logo`} class="h-8 w-auto mr-2 dark:hidden" />
  <img src={LogoDark.src} alt={`${SITE?.name} logo`} class="hidden h-8 w-auto mr-2 dark:inline-block" />
  <span class="sr-only">{SITE?.name}</span>
</div>
