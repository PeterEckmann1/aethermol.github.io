---
import favIcon from '~/assets/favicons/favicon.ico';
import favIconSvgLight from '~/assets/favicons/aethermol-favicon-light.svg';
import favIconSvgDark from '~/assets/favicons/aethermol-favicon-dark.svg';
import appleTouchIcon from '~/assets/favicons/apple-touch-icon.png';
---

<link rel="shortcut icon" href={favIcon} />
<link rel="icon" type="image/svg+xml" href={favIconSvgLight.src} media="(prefers-color-scheme: light)" />
<link rel="icon" type="image/svg+xml" href={favIconSvgDark.src} media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/svg+xml" href={favIconSvgLight.src} />
<link rel="mask-icon" href={favIconSvgDark.src} color="#8D46E7" />
<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon.src} />
