---
import favIcon from '~/assets/favicons/favicon.ico?url';
import favIconSvgLight from '~/assets/favicons/aethermol-favicon-light.svg?url';
import favIconSvgDark from '~/assets/favicons/aethermol-favicon-dark.svg?url';
import appleTouchIcon from '~/assets/favicons/apple-touch-icon.png?url';
---

<link rel="shortcut icon" href={favIcon} />
<link rel="icon" type="image/svg+xml" href={favIconSvgLight} media="(prefers-color-scheme: light)" />
<link rel="icon" type="image/svg+xml" href={favIconSvgDark} media="(prefers-color-scheme: dark)" />
<link rel="icon" type="image/svg+xml" href={favIconSvgLight} />
<link rel="mask-icon" href={favIconSvgDark} color="#8D46E7" />
<link rel="apple-touch-icon" sizes="180x180" href={appleTouchIcon} />
